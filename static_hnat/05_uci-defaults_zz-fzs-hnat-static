#!/bin/sh
# =============================================================
# 放置路径：files/etc/uci-defaults/zz-fzs-hnat-static
# 权限    ：755
# 执行时机：首次开机（返回 0 后由 uci_apply_defaults 自动删除）
#
# 作用：
#   1) 清掉 hnat-detect 的所有触发点（sysupgrade 保留旧配置时兜底）
#   2) 启用每次开机都要跑的 /etc/init.d/fzs-hnat
#   3) 把 TurboACC 固定到 mediatek_hnat
#
# 【为什么必须叫 zz- 开头】
#   uci-defaults 按文件名字典序执行。包自带的是 99-hnat-detect：
#     99-fzs-... < 99-hnat-detect  → 我们若叫 99-* 会先跑，然后被它
#     重新 `uci set firewall.hnat_detect=include` 写回来。
#   zz-* 排在 99-* 之后，保证清理动作最后执行。
#   （编译期已按 01/02 删包时这点是双保险，但仍建议保留。）
# =============================================================

# ---------- 1. 中和自动探测 ----------
# hotplug：包里只有两行、无任何接口过滤，任何 ifup/ifdown 都会跑 detect.uc，
#          detect.uc:286-290 会在变更时 0/1 切换 hook_toggle 清空 FOE 表。
rm -f /etc/hotplug.d/iface/99-hnat-detect
# fw4 reload 触发点
rm -f /usr/share/hnat-detect/firewall.sh
uci -q delete firewall.hnat_detect
uci -q commit firewall
# 包自带的 uci-defaults（若编译期没删包，它可能已经跑过并写了 include）
rm -f /etc/uci-defaults/99-hnat-detect

# 用空脚本占位，防止后续 opkg 安装/升级把 hotplug 又放回来
mkdir -p /etc/hotplug.d/iface
cat > /etc/hotplug.d/iface/99-hnat-detect <<'EOF'
#!/bin/sh
# Disabled by FZS 5GCPE P5 static HNAT (solution 1)
exit 0
EOF
chmod 755 /etc/hotplug.d/iface/99-hnat-detect

# ---------- 2. 启用持久化服务 ----------
# 脚本本体由 files/etc/init.d/fzs-hnat 提供（见 06）
if [ -x /etc/init.d/fzs-hnat ]; then
	/etc/init.d/fzs-hnat enable
else
	logger -t fzs-hnat "ERROR: /etc/init.d/fzs-hnat missing"
fi

# ---------- 3. 固定加速引擎 ----------
# turboacc init.d:30-32 在 fastpath != mediatek_hnat 时会 echo 0 > hook_toggle
[ -e /etc/config/turboacc ] || touch /etc/config/turboacc
uci -q get turboacc.config >/dev/null || uci -q set turboacc.config=turboacc
uci -q set turboacc.config.fastpath='mediatek_hnat'
uci -q set turboacc.config.fastpath_mh_bind_rate='30'
uci -q set turboacc.config.fastpath_mh_update_nfct='0'
uci -q commit turboacc

logger -t fzs-hnat "uci-defaults: hnat-detect disabled, static HNAT enabled"
exit 0

