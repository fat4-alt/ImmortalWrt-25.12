 }
 
+/* Explicitly bind a software FOE entry into its hardware slot.
+ * Mainline relies on the PPE sending the first packet to the CPU, where
+ * mtk_poll_rx() -> __mtk_ppe_check_skb() learns the slot number from the RX
+ * descriptor. An skb injected through PSE_PPE0_PORT cannot use that path
+ * (its sport is not a GDM, mtk_poll_rx() drops it), so compute the slot with
+ * the same mtk_ppe_hash_entry() the hardware uses and commit it now. */
+int mtk_foe_entry_bind_hw(struct mtk_ppe *ppe, struct mtk_flow_entry *entry)
+{
+	u32 hash;
+
+	if (!ppe || !entry)
+		return -EINVAL;
+
+	hash = mtk_ppe_hash_entry(ppe->eth, &entry->data);
+	spin_lock_bh(&ppe_lock);
+	entry->hash = (u16)hash;
+	__mtk_foe_entry_commit(ppe, &entry->data, hash);
+	spin_unlock_bh(&ppe_lock);
+
+	return (int)hash;
+}
+
 static void
 mtk_foe_entry_commit_subflow(struct mtk_ppe *ppe, struct mtk_flow_entry *entry,
 			     u16 hash)
@@ -940,9 +962,14 @@
 	return NULL;
 }
 
+extern void mtk_ppe_extdev_deinit(struct mtk_eth *eth);
+
 void mtk_ppe_deinit(struct mtk_eth *eth)
 {
 	int i;
+
+	if (IS_ENABLED(CONFIG_NET_MEDIATEK_PPE_EXTDEV))
+		mtk_ppe_extdev_deinit(eth);
 
 	for (i = 0; i < ARRAY_SIZE(eth->ppe); i++) {
 		if (!eth->ppe[i])
--- a/drivers/net/ethernet/mediatek/mtk_eth_soc.c
+++ b/drivers/net/ethernet/mediatek/mtk_eth_soc.c
@@ -1353,17 +1353,26 @@
 
 	WRITE_ONCE(desc->txd3, data);
 
-	 /* set forward port */
-	switch (mac->id) {
-	case MTK_GMAC1_ID:
-		data = PSE_GDM1_PORT << TX_DMA_FPORT_SHIFT_V2;
-		break;
-	case MTK_GMAC2_ID:
-		data = PSE_GDM2_PORT << TX_DMA_FPORT_SHIFT_V2;
-		break;
-	case MTK_GMAC3_ID:
-		data = PSE_GDM3_PORT << TX_DMA_FPORT_SHIFT_V2;
-		break;
+	/* set forward port. extdev injection overrides with PSE_PPE0_PORT. */
+	{
+		u8 mtk_extdev_get_fport(void); /* defined in mtk_ppe_extdev_tx.c */
+		u8 extdev_fport = mtk_extdev_get_fport();
+
+		if (extdev_fport) {
+			data = (u32)extdev_fport << TX_DMA_FPORT_SHIFT_V2;
+		} else {
+			switch (mac->id) {
+			case MTK_GMAC1_ID:
+				data = PSE_GDM1_PORT << TX_DMA_FPORT_SHIFT_V2;
+				break;
+			case MTK_GMAC2_ID:
+				data = PSE_GDM2_PORT << TX_DMA_FPORT_SHIFT_V2;
+				break;
+			case MTK_GMAC3_ID:
+				data = PSE_GDM3_PORT << TX_DMA_FPORT_SHIFT_V2;
+				break;
+			}
+		}
 	}
 
 	data |= TX_DMA_SWC_V2 | QID_BITS_V2(info->qid);
@@ -5491,3 +5500,8 @@
